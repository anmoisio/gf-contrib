concrete ScanNoOpposite10MoreInput of ScanNoOpposite10More = ScanInput ** 
{
	lincat VPopp = {s : Str};
	lin
		UseVPopp vpopp = vpopp ;
		AdvAdvVerbAdvVerbAdv    verb adv = {s = verb.s ++ "aavava" ++ adv.s} ;
		AdvVerbAdv              verb adv = {s = verb.s ++ "ava" ++ adv.s} ;
		AdvAdvVerbVerbAdvAdv    verb adv = {s = verb.s ++ "aavvaa" ++ adv.s} ;
		AdvVerbAdvVerbVerbAdvVerbVerb verb adv = {s = verb.s ++ "avavvavv" ++ adv.s} ;
		VerbAdvAdv              verb adv = {s = verb.s ++ "vaa" ++ adv.s} ;
		VerbAdvVerbVerbVerb     verb adv = {s = verb.s ++ "vavvv" ++ adv.s} ;
		AdvAdvVerbVerb          verb adv = {s = verb.s ++ "aavv" ++ adv.s} ;
		VerbVerbVerbAdv         verb adv = {s = verb.s ++ "vvva" ++ adv.s} ;
		AdvVerbAdvVerbAdv       verb adv = {s = verb.s ++ "avava" ++ adv.s} ;
		AdvVerbAdvVerbAdvVerbVerb verb adv = {s = verb.s ++ "avavavv" ++ adv.s} ;
}
